# Copy to .env and change the secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# The API connects as the restricted role created by db/001_schema.sql (row-level security applies)
DATABASE_URL=postgres://cityfix_app:change-me@localhost:5432/cityfix
# Superuser/owner URL, used only by `npm run db:migrate`, `npm run db:synthetic` and tests
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/cityfix

# At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-48-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# File storage for photos and exports
#   local = a folder on this computer (default, nothing to install)
#   s3    = S3-compatible cloud storage for the hosted version (AWS S3, Cloudflare R2, ...)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Address the apps use to reach this API (used in photo and download links)
PUBLIC_API_URL=http://localhost:3000

# Only used when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=ap-southeast-2
S3_BUCKET=cityfix-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Email (Mailpit locally: open http://localhost:8025 to read mail)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=CityFix <no-reply@council.example>

# AI: openai | azure | gemini | none (none = keyword fallback only)
AI_PROVIDER=none
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=8000
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
GEMINI_API_KEY=
# For Gemini set AI_MODEL=gemini-2.5-flash (or the model your key allows)

WORKER_ENABLED_JOBS=deliveries,sla,autoclose,stats,summaries,monthly,exports
